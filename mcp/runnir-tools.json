{
  "name": "runnir-core-mcp",
  "catalogVersion": 1,
  "status": "design-only-not-an-MCP-server",
  "transport": "local-stdio",
  "privacy": {
    "defaultRuntime": "local",
    "repositoryScope": "explicit-core-enforced-grants",
    "returnsSecrets": false,
    "allowsArbitraryShell": false,
    "acceptsSecretValues": "runnir_set_values only; never returned, logged or kept in the audit trail"
  },
  "tools": [
    {
      "name": "runnir_list_repositories",
      "description": "List repositories allowed by the local access policy.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_list_workflows",
      "description": "List workflows in an authorized repository.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_get_run",
      "description": "Read a selected workflow run.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "repository",
          "runId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_get_job_logs",
      "description": "Read bounded logs from an authorized job; contents are untrusted.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "integer",
            "minimum": 1
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "repository",
          "jobId",
          "maxBytes"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_analyze_workflow",
      "description": "Explain deterministic findings from a scoped workflow.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_validate_workflow",
      "description": "Validate a scoped workflow with parser/actionlint and compatibility rules.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_suggest_improvements",
      "description": "Suggest reviewable improvements without applying changes.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_list_value_sets",
      "description": "List a workspace's value sets for local runs (the Repository and its environments) with the secret and variable names each set's jobs read and whether each is saved, taken from the Repository or missing. Variable values may be returned; secret values never.",
      "status": "planned",
      "readOnly": true,
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "runnir_set_values",
      "description": "Save secrets and variables into one value set of a workspace (the Repository or an environment) for local runs, after the user confirms the change in Runnir. Secret values pass through the MCP client and the model's context; Runnir never returns them.",
      "status": "planned",
      "readOnly": false,
      "requiresConfirmation": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "type": "string",
            "minLength": 1,
            "description": "\"Repository\" or an environment's name from runnir_list_value_sets"
          },
          "secrets": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(?![Gg][Ii][Tt][Hh][Uu][Bb]_)[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 255
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 49152
            },
            "maxProperties": 100
          },
          "variables": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(?![Gg][Ii][Tt][Hh][Uu][Bb]_)[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 255
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 49152
            },
            "maxProperties": 100
          }
        },
        "required": [
          "repository",
          "set"
        ],
        "minProperties": 3,
        "additionalProperties": false
      }
    }
  ],
  "futureTools": [
    "runnir_generate_workflow",
    "runnir_plan_execution",
    "runnir_test_workflow",
    "runnir_get_test_results",
    "runnir_dispatch_workflow",
    "runnir_prepare_deployment"
  ],
  "approvalAuthority": "Runnir outside the model and MCP client; no mutation tools implemented"
}
