  "keywords": ["github-actions", "act", "local-runs", "secrets", "macos"],
  "mcpServers": {
    "runnir": {
      "command": "/Applications/Runnir.app/Contents/Helpers/runnir-core",
      "args": ["mcp"]
    }
  }
}
